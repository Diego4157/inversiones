// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COBRADOR
  COLLECTOR
}

enum AssetCategory {
  VEHICULO
  INMUEBLE
  OTRO
}

enum AssetStatus {
  ACTIVO
  INACTIVO
  MANTENIMIENTO
}

enum LoanStatus {
  ACTIVE
  MORA
  CASTIGADO
  RECOVERY
  PAID
  CONGELADO
  FINALIZADO
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  password      String
  name          String
  role          Role        @default(COBRADOR)
  username      String?     @unique
  passwordHash  String?
  payments      Payment[]
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
}

model Client {
  id           Int      @id @default(autoincrement())
  fullName     String
  documentId   String   @unique
  phone        String?
  address      String?
  routeZone    String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  status       String   @default("ACTIVE") // ACTIVE, CONGELADO, CASTIGADO, INACTIVE
  loans        Loan[]
  createdAt    DateTime @default(now())
}

model Loan {
  id                Int                @id @default(autoincrement())
  clientId          Int
  client            Client             @relation(fields: [clientId], references: [id])
  totalAmount       Decimal            @db.Decimal(12, 2)
  capitalAmount     Decimal            @db.Decimal(12, 2)
  interestRate      Decimal            @db.Decimal(5, 2)
  balance           Decimal            @db.Decimal(12, 2)
  installmentsTotal Int
  installmentsPaid  Int                @default(0)
  frequency         String             @default("DAILY") // DAILY, WEEKLY, BIWEEKLY
  atrasosAcumulados Int                @default(0)
  status            LoanStatus         @default(ACTIVE)
  startDate         DateTime?          @default(now())
  endDate           DateTime?
  payments          Payment[]
  paymentPromises   PaymentPromise[]
  scheduledReceipts ScheduledReceipt[]
  refinanceHistory  RefinanceHistory[]
  additions         LoanAddition[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model LoanAddition {
  id              Int      @id @default(autoincrement())
  loanId          Int
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  previousBalance Decimal  @db.Decimal(12, 2)
  newBalance      Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
}

model RefinanceHistory {
  id              Int      @id @default(autoincrement())
  loanId          Int
  loan            Loan     @relation(fields: [loanId], references: [id])
  previousBalance Decimal  @db.Decimal(12, 2)
  addedCapital    Decimal  @db.Decimal(12, 2)
  newBalance      Decimal  @db.Decimal(12, 2)
  refinancedAt    DateTime @default(now())
}

model Payment {
  id              Int      @id @default(autoincrement())
  loanId          Int
  loan            Loan     @relation(fields: [loanId], references: [id])
  collectorId     Int
  collector       User     @relation(fields: [collectorId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @default("EFECTIVO") // EFECTIVO, NEQUI, DAVIPLATA, MIXTO
  cashAmount      Decimal? @db.Decimal(12, 2)
  digitalAmount   Decimal? @db.Decimal(12, 2)
  previousBalance Decimal  @db.Decimal(12, 2)
  newBalance      Decimal  @db.Decimal(12, 2)
  arrearsCount    Int      @default(0)
  paymentDate     DateTime @default(now())
}

model PaymentPromise {
  id             Int      @id @default(autoincrement())
  loanId         Int
  loan           Loan     @relation(fields: [loanId], references: [id])
  promiseDate    DateTime @db.Date
  amountExpected Decimal  @db.Decimal(12, 2)
  status         String   @default("PENDING") // PENDING, FULFILLED, BROKEN
  createdAt      DateTime @default(now())
}

model Investor {
  id               Int                   @id @default(autoincrement())
  fullName         String
  totalCapital     Decimal               @default(0) @db.Decimal(15, 2)
  profitRate       Decimal               @default(0) @db.Decimal(5, 2)
  paymentFrequency String                @default("MONTHLY")
  nextPayoutDate   DateTime?
  transactions     InvestorTransaction[]
  createdAt        DateTime              @default(now())
}

model InvestorTransaction {
  id              Int      @id @default(autoincrement())
  investorId      Int
  investor        Investor @relation(fields: [investorId], references: [id])
  amount          Decimal  @db.Decimal(15, 2)
  type            String // CONTRIBUTION, WITHDRAWAL, PROFIT_SHARE
  transactionDate DateTime @default(now())
}

model Asset {
  id                 Int            @id @default(autoincrement())
  category           AssetCategory  @default(VEHICULO)
  name               String
  identifier         String?        // Placa, matrícula inmobiliaria, etc.
  plate              String?        // Retrocompatibilidad
  purchasePrice      Decimal?       @db.Decimal(12, 2)
  dailyTargetIncome  Decimal        @default(35000) @db.Decimal(10, 2)
  dailyRentTarget    Decimal?       @db.Decimal(10, 2) // Retrocompatibilidad
  status             AssetStatus    @default(ACTIVO)
  
  // Reglas de cajones de ahorro parametrizables por activo
  debtPercent        Decimal?       @default(51.1) @db.Decimal(5, 2)
  soatAmount         Decimal?       @default(2000) @db.Decimal(10, 2)
  maintenanceAmount  Decimal?       @default(3000) @db.Decimal(10, 2)
  contingencyAmount  Decimal?       @default(5000) @db.Decimal(10, 2)

  revenues           AssetRevenue[]
  drawers            SavingsDrawer[]
  createdAt          DateTime       @default(now())
}

model AssetRevenue {
  id             Int      @id @default(autoincrement())
  assetId        Int
  asset          Asset    @relation(fields: [assetId], references: [id])
  amountReceived Decimal  @db.Decimal(12, 2)
  revenueDate    DateTime @default(now())
}

model SavingsDrawer {
  id           Int                 @id @default(autoincrement())
  assetId      Int
  asset        Asset               @relation(fields: [assetId], references: [id])
  type         String // DEBT, SOAT_TECNO, MAINTENANCE, CONTINGENCY, PROFIT
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  transactions DrawerTransaction[]
  lastUpdated  DateTime            @default(now())
}

model DrawerTransaction {
  id              Int           @id @default(autoincrement())
  drawerId        Int
  drawer          SavingsDrawer @relation(fields: [drawerId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  description     String?
  transactionDate DateTime      @default(now())
}

model ScheduledReceipt {
  id              Int        @id @default(autoincrement())
  loanId          Int
  loan            Loan       @relation(fields: [loanId], references: [id])
  date            DateTime   @db.Date
  status          String     @default("PENDING") // PENDING, PAID, ATRASADO, DOMINICAL
  expectedAmount  Decimal    @db.Decimal(12, 2)
  isManual        Boolean    @default(false)
  createdAt       DateTime   @default(now())
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model LoanModality {
  id           Int      @id @default(autoincrement())
  name         String
  frequency    String   // DAILY, WEEKLY, BIWEEKLY
  interestRate Decimal  @db.Decimal(5, 2)
  installments Int
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREAR_CREDITO, ABONO_PAGO, AGREGAR_CAPITAL, CONGELAR_CLIENTE, CIERRE_CAJA
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

